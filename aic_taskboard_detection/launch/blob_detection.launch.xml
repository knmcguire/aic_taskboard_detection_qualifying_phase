<?xml version="1.0"?>
<launch>
  <arg
    name="params_file"
    default="$(find-pkg-share aic_taskboard_detection)/config/blob_detection.params.yaml"
  />
  <arg
    name="gripper_mask_dir"
    default="$(find-pkg-share aic_taskboard_detection)/resource"
  />
  <node
    pkg="aic_taskboard_detection"
    exec="blob_detection"
    name="blob_detection"
    output="screen"
  >
    <param from="$(var params_file)"/>
    <param name="gripper_mask_dir" value="$(var gripper_mask_dir)"/>
  </node>
</launch>
